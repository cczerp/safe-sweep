# ==================================================
# ULTIMATE DEFENSE SYSTEM - Environment Configuration
# ==================================================

# ============ YOUR SAFE & CONTRACTS ============
SAFE_ADDRESS=0xYourSafeWalletAddress
VAULT_ADDRESS=0xYourVaultAddress
SWEEPER_MODULE=0xYourSweeperModuleContractAddress
USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# ============ YOUR WALLET ============
PRIVATE_KEY=your_private_key_here

# ============ EOA WALLET BOT (Trust Wallet) ============
# For the EOA Wallet Bot - uses the same RPC endpoints above
EOA_WALLET_ADDRESS=0xYourTrustWalletAddress
EOA_PRIVATE_KEY=your_trust_wallet_private_key_here

# EOA Bot Settings (optional - uses defaults if not set)
# Gas premium: How much to outbid attacker (1.0 = 2x their gas, 0.5 = 1.5x)
# With MEV bundles: 1.0 is plenty (bundles guarantee ordering regardless)
# Without MEV bundles: Higher = better chance in gas war
EOA_GAS_PREMIUM=1.0
EOA_MAX_GAS_PRICE_GWEI=1000
EOA_MONITORING_INTERVAL=500
EOA_ENABLE_TXPOOL=true
EOA_ENABLE_WEBSOCKET=true

# ============ RPC ENDPOINTS ============
# More endpoints = better shotgun performance
# Add as many as you have access to

# Alchemy (recommended for primary + NATIVE POLYGON BUNDLES!)
ALCHEMY_HTTP=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_WSS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=YOUR_KEY

# QuickNode (recommended for WebSocket monitoring)
QUICKNODE_HTTP=https://your-endpoint.matic.quiknode.pro/YOUR_KEY/
QUICKNODE_WSS=wss://your-endpoint.matic.quiknode.pro/YOUR_KEY/

# Infura
INFURA_HTTP=https://polygon-mainnet.infura.io/v3/YOUR_KEY
INFURA_WSS=wss://polygon-mainnet.infura.io/ws/v3/YOUR_KEY
INFURA_GAS_API_KEY=YOUR_KEY
INFURA_GAS_API_URL=https://gas.api.infura.io/v3

# Ankr (free, good backup)
ANKR_HTTP=https://rpc.ankr.com/polygon

# Nodies
NODIES_HTTP=https://lb.nodies.app/v1/YOUR_KEY

# ============ BLOXROUTE (ETHEREUM/BSC ONLY) ============
# NOTE: BloxRoute does NOT support Polygon
# For Polygon, use Alchemy bundles instead (see ALCHEMY_API_KEY above)
# Only needed if you're running this on Ethereum or BSC
BLOXROUTE_HEADER=YOUR_BLOXROUTE_AUTH_HEADER

# ============ GAS STRATEGY ============
CHAIN_ID=137

# Emergency gas multiplier for pre-signed transactions
# Higher = more expensive but faster inclusion
# Range: 2.0 - 20.0, Recommended: 15.0 for maximum speed
EMERGENCY_GAS_MULTIPLIER=15.0

# Gas premium when outbidding attackers
# 0.5 = 50% above attacker's gas, 1.0 = 100% above
# Range: 0.5 - 3.0, Recommended: 1.5 for aggressive outbidding
GAS_PREMIUM=1.5

# Maximum gas price limit (safety mechanism)
# Prevents spending too much in gas wars
MAX_GAS_PRICE_GWEI=1000

# Baseline gas multiplier for standard operations
# Used for pre-signed pool generation
BASE_GAS_MULTIPLIER=2.5

# ============ PRE-SIGNED POOL CONFIG ============
# Number of pre-signed transactions to keep ready
# More = can handle more threats in quick succession
# Range: 3 - 10, Recommended: 5
POOL_SIZE=5

# How often to refresh gas prices and regenerate pool (milliseconds)
# One Polygon block = ~2 seconds = 2000ms
# Recommended: 12000ms (every 6 blocks)
GAS_REFRESH_INTERVAL=12000

# ============ MONITORING CONFIG ============
# WebSocket reconnect settings
WS_RECONNECT_INTERVAL=15000
WS_MAX_RECONNECT_ATTEMPTS=15

# Mempool gas multiplier (for botcontrol.js)
MEMPOOL_GAS_MULTIPLIER=2.0

# ============ SYSTEM SETTINGS ============
# Nonce persistence path (auto-generated if not set)
NONCE_PERSIST_PATH=./.nonce_cache.json

# ============ DEBUGGING & TESTING ============
# DRY_RUN: Set to "true" to test without sending real transactions
DRY_RUN=false

# DEBUG: Set to "true" for verbose logging
DEBUG=false

# ============ MEV BUNDLE CONFIGURATION ============
# MEV Bundles provide GUARANTEED transaction ordering
# When enabled, your TX will ALWAYS execute before attacker's
#
# POLYGON: Uses Marlin Relay (Flashbots equivalent for Polygon)
# You need a SEPARATE wallet for signing bundle submissions (MEV searcher key)
# This is NOT your main wallet - it's just for bundle authentication
# Generate one: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"

# MEV Searcher private key (REQUIRED for bundles, separate from your main wallet)
MEV_SEARCHER_KEY=your_mev_searcher_private_key_here

# Enable/disable MEV bundles (default: true)
ENABLE_MEV_BUNDLES=true

# Bundle timeout in seconds
# How long to wait for bundle inclusion
BUNDLE_TIMEOUT=30

# Max blocks ahead to target
# Try to include bundle in next N blocks
# Range: 1-5, Recommended: 3
MAX_BLOCKS_AHEAD=3

# Priority fee for bundle transactions (in gwei)
# Higher = better inclusion chance
# Range: 30-100, Recommended: 50
BUNDLE_PRIORITY_FEE=50

# ============ NONCE CANCELLATION STRATEGY ============
# Experimental strategy that sends competing transactions to delay attackers
# This creates mempool congestion and can buy time for sweeps

# Enable/disable nonce cancellation (default: true)
ENABLE_NONCE_CANCELLATION=true

# Gas multiplier for cancellation txs (default: 3x attacker's gas)
CANCELLATION_GAS_MULTIPLIER=3

# Emergency gas for cancellation when attacker gas unknown (in gwei)
NONCE_CANCELLATION_TIP=500
NONCE_CANCELLATION_MAX_FEE=1000

# ============ USAGE EXAMPLES ============
#
# ULTIMATE SETUP (MEV bundles - 100% win rate):
#   ENABLE_MEV_BUNDLES=true
#   BUNDLE_PRIORITY_FEE=50
#   MAX_BLOCKS_AHEAD=3
#   (Uses MEV bundles first, falls back to shotgun if needed)
#
# TESTING SETUP (no real transactions):
#   DRY_RUN=true
#   DEBUG=true
#   EMERGENCY_GAS_MULTIPLIER=2.0
#
# CONSERVATIVE SETUP (cheaper, slower):
#   ENABLE_MEV_BUNDLES=false
#   EMERGENCY_GAS_MULTIPLIER=2.0
#   GAS_PREMIUM=0.3
#   POOL_SIZE=3
#
# AGGRESSIVE SETUP (expensive, fastest):
#   ENABLE_MEV_BUNDLES=true
#   BUNDLE_PRIORITY_FEE=100
#   EMERGENCY_GAS_MULTIPLIER=5.0
#   GAS_PREMIUM=1.0
#   POOL_SIZE=10
#
# RECOMMENDED SETUP (balanced):
#   ENABLE_MEV_BUNDLES=true
#   BUNDLE_PRIORITY_FEE=50
#   EMERGENCY_GAS_MULTIPLIER=3.5
#   GAS_PREMIUM=0.5
#   POOL_SIZE=5
#
# ==================================================
